# Copy to .env.local for local development (never commit .env.local).
# One variable per mockup client, named MOCKUP_PASS_<SLUG-IN-UPPERCASE>.
# The slug is the folder name under mockups/, e.g. mockups/acme-corp/ -> MOCKUP_PASS_ACME_CORP.
# In production, set the same variables in the Vercel project's Environment Variables settings.

MOCKUP_PASS_TEST=changeme
